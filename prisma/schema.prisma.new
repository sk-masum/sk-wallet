generator client {
  provider = "prisma-client-js"
  output   = "../web/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  accounts              Account[]
  sessions              Session[]
  cards                 card[]
  credentials           credential_record[]
  documents             document_record[]
  documentAccessAudits  document_access_audit[]
  dashboardFavorites    dashboard_favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models (converted from PostgreSQL to SQLite)
model card {
  id            BigInt         @id @default(autoincrement())
  created_at    DateTime       @default(now())
  card_name     String?
  number        String
  cvv           String
  holder_name   String?
  network       Int
  isCredit      Boolean?       @default(true)
  expiry_month  Int            @default(1)
  expiry_year   Int            @default(2025)
  owner_id      String
  color_name    String?
  tags          String         @default("[]")
  status        String         @default("active")
  credit_limit  Decimal?       @db.Real
  provider_id   BigInt?
  billing_date  Int?
  payment_date  Int?
  
  user          User           @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  card_provider card_provider? @relation(fields: [provider_id], references: [id])

  @@index([provider_id])
  @@index([owner_id])
}

model card_provider {
  id         BigInt   @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  card       card[]
}

model credential_record {
  id              String   @id @default(cuid())
  user_id         String
  credential_type String
  service_name    String
  identifier      String?
  secret_token    String
  secret_hash     String
  secret_last4    String
  masked_secret   String
  url             String?
  notes           String?
  metadata        String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())
  
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, credential_type, service_name, identifier])
  @@index([credential_type])
  @@index([user_id])
  @@index([updated_at(sort: Desc)])
}

model document_access_audit {
  id              BigInt           @id @default(autoincrement())
  document_id     String?
  actor_user_id   String?
  action          String
  context         String?
  created_at      DateTime         @default(now())
  
  user            User?            @relation(fields: [actor_user_id], references: [id])
  document_record document_record? @relation(fields: [document_id], references: [id])

  @@index([actor_user_id])
  @@index([document_id])
}

model document_file {
  id              String          @id @default(cuid())
  document_id     String
  file_path       String
  file_side       String          @default("front")
  mime_type       String?
  size_bytes      BigInt?
  created_at      DateTime        @default(now())
  
  document_record document_record @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id])
}

model document_record {
  id                    String                  @id @default(cuid())
  user_id               String
  document_type         String
  document_number_token String
  document_number_last4 String
  document_number_hash  String
  masked_number         String
  name_on_document      String?
  metadata              String?
  verified_at           DateTime?
  expires_at            DateTime?
  created_at            DateTime                @default(now())
  updated_at            DateTime                @default(now())
  category              String?
  
  user                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document_access_audit document_access_audit[]
  document_file         document_file[]

  @@unique([document_type, document_number_hash])
  @@index([category])
  @@index([user_id])
  @@index([updated_at(sort: Desc)])
}

model dashboard_favorite {
  id          BigInt   @id @default(autoincrement())
  user_id     String
  feature_key String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
  
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, feature_key])
  @@index([user_id])
  @@index([updated_at(sort: Desc)])
}

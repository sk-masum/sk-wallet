# Production Environment Variables for Vercel
# Copy this file to .env.production and fill in the actual values
# NEVER commit secrets to git - only use Vercel environment variables

# Database Configuration for Turso (Production)
# Get from: https://app.turso.io
# Format: libsql://your-db-name-username.aws-ap-northeast-1.turso.io?authToken=YOUR_TOKEN
# CRITICAL: Include the authToken parameter!
DATABASE_URL="libsql://your-prod-db-name.aws-region.turso.io?authToken=your-prod-auth-token"

# NextAuth Configuration (Production)
# Generate with: openssl rand -base64 32
# CRITICAL: Must be a 32+ character random string
NEXTAUTH_SECRET="your-production-nextauth-secret-min-32-chars"

# NEXTAUTH_URL must match your production domain
# Examples:
# - https://sk-wallet.com
# - https://sk-wallet.vercel.app
NEXTAUTH_URL="https://your-production-domain.com"

# Application Secrets (Production)
# Generate with: openssl rand -base64 32
# Used for card tokenization
CARD_TOKEN_SECRET="your-production-card-token-secret-min-32-chars"

# Optional: Analytics & Monitoring
# SENTRY_DSN="your-sentry-dsn-for-error-tracking"
# GOOGLE_ANALYTICS_ID="your-ga-id"

# Optional: Feature Flags
# ENABLE_BETA_FEATURES=false
# MAINTENANCE_MODE=false

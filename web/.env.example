# Database Configuration for Turso
# Get your connection string from: https://app.turso.io
# 
# Local Development: Use file-based SQLite
# DATABASE_URL="file:./dev.db"
#
# Production/Vercel: Use Turso with auth token
# Format: libsql://your-db-name-username.aws-ap-northeast-1.turso.io?authToken=YOUR_TOKEN
# IMPORTANT: Include the authToken query parameter for Vercel/production
DATABASE_URL="libsql://your-db-name-username.aws-ap-northeast-1.turso.io?authToken=your-turso-token-here"

# NextAuth Configuration
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# CRITICAL: Must be a long random string (minimum 32 characters)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# NEXTAUTH_URL must match your deployment domain
# Local: http://localhost:3000
# Vercel: https://your-domain.vercel.app
NEXTAUTH_URL="https://your-domain.vercel.app"

# Application Secrets
# Generate a long random string (at least 32 characters)
# Used for card number and CVV tokenization
CARD_TOKEN_SECRET="your-long-random-secret-key-here-min-32-chars"

